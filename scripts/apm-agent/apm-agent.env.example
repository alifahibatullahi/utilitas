# Agen APM PowerOps - isi, lalu simpan sebagai apm-agent.env di folder yang sama.
# Berkas ini berisi password: jangan dibagikan dan jangan dikirim lewat WA.

# Akun OneKey untuk membuka E-Logsheet APM
APM_USERNAME=
APM_PASSWORD=

# Harus sama persis dengan APM_INGEST_SECRET di Vercel (Settings > Environment Variables)
APM_INGEST_SECRET=

# Alamat PowerOps (biarkan bila tidak berubah)
POWEROPS_URL=https://utilitas.vercel.app
